# Copiar este archivo como .env y completar los valores locales.
# NUNCA commitear el .env real — solo este .env.example

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/mesa_click?sslmode=disable

# Puerto donde corre el servidor Go
PORT=8080

# URL pública o local del frontend (usada para construir los enlaces de login en los emails)
APP_URL=http://localhost:3000

# Clave secreta para firmar los JWT
JWT_SECRET=tu_clave_secreta_jwt_muy_segura

# Entorno: development | production
APP_ENV=development

# ----------------------------------------------------
# Sin SMTP_HOST ni RESEND_API_KEY el magic link NO se envía: solo se escribe
# en el log. En ese caso, y si APP_ENV != production, POST /auth/magic-link
# devuelve el enlace en el campo "magic_link_dev" para poder probar el login.
# ----------------------------------------------------

# ----------------------------------------------------
# Configuración SMTP (para envío de emails reales)
# Compatible con Gmail, Outlook, Brevo, SendGrid, Mailtrap, etc.
# ----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_o_api_key
SMTP_FROM=no-reply@mesaclick.com

# ----------------------------------------------------
# Alternativa: Resend (si se usa API HTTP en vez de SMTP)
# ----------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
# FROM_EMAIL=onboarding@resend.dev
